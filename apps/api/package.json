{
  "name": "@dineos/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push --force",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "db:reset": "tsx --env-file-if-exists=../../.env src/db/reset.ts && drizzle-kit push --force && tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "test:flow": "tsx --env-file-if-exists=../../.env src/smoke.ts"
  },
  "dependencies": {
    "@dineos/shared": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "@hono/node-ws": "^1.0.5",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.38.2",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
